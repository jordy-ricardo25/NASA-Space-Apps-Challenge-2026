# Flame in Freefall — variables de entorno. Copiar como .env.local.
# Los secretos viven solo en el servidor: nunca usar el prefijo NEXT_PUBLIC_ para una clave.

# Idioma por defecto de la interfaz: es | en
NEXT_PUBLIC_DEFAULT_LANG=es

# URL pública del sitio (la usa sitemap.xml)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Módulo de música: estructura creada, sin implementar (src/features/audio/README.md)
NEXT_PUBLIC_ENABLE_MUSIC=false

# --- Backend del equipo (emberwatch API: FastAPI, carpeta api/) ---
# Datos reales de NASA PSI. Si está vacío o no responde, la plataforma usa sus
# propios servicios y la copia de respaldo (npm run psi-snapshot).
API_BASE_URL=https://emberwatch-api.devcoreinc.com

# --- Asistente Flamey: modelo del equipo en Ollama (opcional) ---
# Si OLLAMA_BASE_URL tiene valor, Flamey pregunta primero a este modelo y, si no
# responde, sigue con Gemini (si hay clave) o con sus fichas verificadas.
# Local: http://localhost:11434 · Publicado: la URL https del servidor o del túnel.
OLLAMA_BASE_URL=
# Nombre exacto del modelo, como sale en "ollama list". Vacío: se elige uno de
# los instalados (qwen2.5 primero, como en el Flamey de Johnatan).
OLLAMA_MODEL=
# Solo si el servidor está detrás de un proxy que pide "Authorization: Bearer".
OLLAMA_API_KEY=
# Tiempo máximo por respuesta (ms; la ruta del chat corta a los 30 s), contexto
# y tope de la respuesta (tokens). Valores pensados para modelos pequeños.
OLLAMA_TIMEOUT_MS=25000
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=260

# --- Asistente Flamey: Gemini con File Search (opcional) ---
# Sin estas claves el asistente responde con las respuestas aprobadas, el motor
# físico y la base de conocimiento local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Lo escribe "npm run ingest" la primera vez; después se reutiliza.
FILE_SEARCH_STORE=

# --- Voz del asistente: Fish Audio (opcional) ---
# Sin clave, la respuesta se lee con la voz del navegador. Una voz clonada es
# contenido generado con IA y la interfaz lo declara.
FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s2.1-pro-free
